APP_ENV=development
HTTP_ADDR=:8080
STORE_DRIVER=memory
# postgres | mongodb | memory
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=go_rest_starter
JWT_ISSUER=nextjs-app
JWT_AUDIENCE=go-api
JWT_PUBLIC_KEY_FILE=./.local/keys/api-public.pem
# In production, configure HTTPS and server-to-server network policies.
